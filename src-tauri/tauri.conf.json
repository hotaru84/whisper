{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperScribe",
  "version": "0.1.0",
  "identifier": "com.hiroo.whisper-scribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": {
      "script": "powershell -ExecutionPolicy Bypass -File scripts/copy-sherpa-dlls.ps1",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperScribe",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/whisper-large-v3-turbo/**/*": "resources/models/whisper-large-v3-turbo/",
      "resources/models/diarization/**/*": "resources/models/diarization/",
      "resources/models/vad/**/*": "resources/models/vad/",
      "resources/models/audio-tagging/**/*": "resources/models/audio-tagging/",
      "resources/bin/**/*": "."
    }
  }
}
