# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Whisper model files (~574MB for large-v3-turbo q5_0) - fetched separately, see README.md
src-tauri/resources/models/*
!src-tauri/resources/models/.gitkeep

# sherpa-onnx shared-library DLLs, copied here by scripts/copy-sherpa-dlls.ps1
# (build.beforeBundleCommand in tauri.conf.json) from the Cargo target dir.
# Build output, not source -- and copied fresh on every bundle build anyway.
src-tauri/resources/bin/*
!src-tauri/resources/bin/.gitkeep

# Accuracy fixtures: recordings and their reference transcripts stay local.
src-tauri/fixtures/*
!src-tauri/fixtures/README.md

# CER harness output
cer-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
